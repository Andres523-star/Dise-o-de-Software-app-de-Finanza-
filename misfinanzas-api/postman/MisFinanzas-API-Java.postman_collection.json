    {
      "name": "1. Divisas (TRM) – IAnalistaDivisas + TrmApiAdapter",
      "description": "API externa de tasas a través del adaptador (patrón Adaptador).",
      "item": [
        {
          "name": "1.1 Tasas con base USD → 200",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/divisas/USD",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "divisas",
                "USD"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código de estado 200\", () => pm.expect(pm.response.code).to.be.oneOf([200]));",
                  "pm.test(\"Trae la tasa del peso colombiano\", () => pm.expect(pm.response.json()).to.have.property(\"COP\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "1.2 Convertir 100 USD a COP → 200",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/divisas/convertir?monto=100&de=USD&a=COP",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "divisas",
                "convertir"
              ],
              "query": [
                {
                  "key": "monto",
                  "value": "100"
                },
                {
                  "key": "de",
                  "value": "USD"
                },
                {
                  "key": "a",
                  "value": "COP"
                }
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código de estado 200\", () => pm.expect(pm.response.code).to.be.oneOf([200]));",
                  "const r = pm.response.json();",
                  "pm.test(\"resultado = monto × tasa\", () => pm.expect(r.resultado).to.be.closeTo(r.monto * r.tasa, 0.01));"
                ]
              }
            }
          ]
        },
        {
          "name": "1.3 Moneda que no existe → 422",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/divisas/XXX",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "divisas",
                "XXX"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código de estado 422\", () => pm.expect(pm.response.code).to.be.oneOf([422]));",
                  "pm.test(\"Explica que la moneda no es soportada\", () => pm.expect(pm.response.json().mensaje).to.include(\"no es soportada\"));"
                ]
              }
            }
          ]
        }
      ]
