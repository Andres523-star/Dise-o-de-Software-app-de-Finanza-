rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isMember(board) {
      return isSignedIn() && request.auth.uid in board.members;
    }

    function isPending(board) {
      return isSignedIn()
        && request.auth.token.email != null
        && request.auth.token.email.lower() in board.pendingShares;
    }

    match /usuarios/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /tableros/{boardId} {
      allow read: if isMember(resource.data) || isPending(resource.data);
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.auth.uid in request.resource.data.members;
      allow update: if isMember(resource.data) || isPending(resource.data);
      allow delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}